# Phase 1: No external APIs needed
# Phase 2: Groq API (free tier — console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Phase 4: Slack Webhooks (free — api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Database URL (Optional: For Postgres instead of SQLite)
DATABASE_URL=postgresql://user:pass@localhost:5432/pipeline

# SQLite DB Path (Used if DATABASE_URL is empty)
# Set to True to skip external API calls (for testing)
MOCK_MODE=True
# Database path (default: pipeline.db in project root)
DB_PATH=pipeline.db

# Phase 7: Observability (LangSmith & OpenTelemetry)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=autonomous-data-pipeline
OTEL_SERVICE_NAME=pipeline-agent
